<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. launchd does not search PATH and does not expand ~, so the binary
  and log paths must be absolute; they are placeholders. The README beside this
  file has a one-liner that fills them in from `command -v yapitalism-mcp`,
  which beats editing by hand.

  This runs the INSTALLED entry point. The previous version of this file pointed
  at one specific checkout with PYTHONPATH set at a hard-coded /Users path, so
  it could only ever have worked on the machine it was written on.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.yapitalism.mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>__YAPITALISM_MCP_BIN__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>YAPITALISM_MCP_HOST</key><string>127.0.0.1</string>
    <key>YAPITALISM_MCP_PORT</key><string>8792</string>
    <!--
      launchd hands a service a minimal PATH — /usr/bin:/bin:/usr/sbin:/sbin and
      little else — and it does NOT read a login shell. Every binary this server
      shells out to therefore vanishes: `panes_list` reported "tmux is not
      installed" on a machine with tmux at /opt/homebrew/bin/tmux, and
      `panes_create` would have failed the same way on codex, claude and kimi.
      Found by calling the tools through the running service rather than in a
      shell, which is the only place the difference shows.
    -->
    <key>PATH</key><string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/yapitalism-mcp.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/yapitalism-mcp.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
